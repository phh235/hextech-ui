# Canonical public origin used by search and social metadata.
NEXT_PUBLIC_SITE_URL=https://hextech-ui.vercel.app
# Optional registry override. Blank uses localhost locally and the public origin on Vercel.
NEXT_PUBLIC_REGISTRY_URL=
# Maintainer-supplied private repository. This config does not push or change GitHub visibility.
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/phh235/hextech-ui

# Optional Search Console verification token; leave empty until a real token is issued.
GOOGLE_SITE_VERIFICATION=

# Server only. Copy this file to .env.local and set your OpenRouter key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini
