{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "@/components/ui/internal-smoke": ["../../packages/react/src/internal/internal-smoke.tsx"],
      "@/hooks/use-internal-state": ["../../registry/hooks/use-internal-state.ts"],
      "@/lib/cn": ["../../packages/utils/src/cn.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".source/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
