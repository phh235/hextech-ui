    "@hextech-ui/react": "workspace:*",
    "@hextech-ui/themes": "workspace:*",
    "@hextech-ui/tokens": "workspace:*",
    "@hextech-ui/utils": "workspace:*",
    "@hookform/resolvers": "6.0.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.143",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
