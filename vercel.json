{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "pnpm --dir ../.. install --frozen-lockfile",
      "buildCommand": "pnpm --dir ../.. build",
      "devCommand": "pnpm --dir ../.. dev --env-mode=loose"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
